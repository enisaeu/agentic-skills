{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enisa:aiteam:findings-report-data:3.0.0",
  "title": "Report Data",
  "description": "Canonical, reporting-only data for the static findings report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report",
    "findings"
  ],
  "properties": {
    "report": {
      "$ref": "#/$defs/report"
    },
    "executiveSummary": {
      "$ref": "#/$defs/executiveSummary"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "shortString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "longString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50000
    },
    "stringList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "informational"
      ]
    },
    "findingRef": {
      "type": "string",
      "pattern": "^F-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "targetRef": {
      "type": "string",
      "pattern": "^SRC-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "evidenceRef": {
      "type": "string",
      "pattern": "^EV-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/shortString"
        },
        "businessUnit": {
          "$ref": "#/$defs/shortString"
        }
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/shortString"
        },
        "role": {
          "$ref": "#/$defs/shortString"
        }
      }
    },
    "reviewPeriod": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/shortString"
        },
        "title": {
          "$ref": "#/$defs/shortString"
        },
        "version": {
          "$ref": "#/$defs/shortString"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "final"
          ]
        },
        "classification": {
          "$ref": "#/$defs/shortString"
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "client": {
          "$ref": "#/$defs/party"
        },
        "provider": {
          "$ref": "#/$defs/party"
        },
        "authors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/person"
          }
        },
        "reviewers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/person"
          }
        },
        "issuedAt": {
          "type": "string",
          "format": "date"
        },
        "reviewPeriod": {
          "$ref": "#/$defs/reviewPeriod"
        }
      }
    },
    "executiveSummary": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "overview": {
          "$ref": "#/$defs/longString"
        },
        "conclusion": {
          "$ref": "#/$defs/longString"
        },
        "overallRisk": {
          "$ref": "#/$defs/severity"
        },
        "businessImpacts": {
          "$ref": "#/$defs/stringList"
        },
        "keyObservations": {
          "$ref": "#/$defs/stringList"
        },
        "strengths": {
          "$ref": "#/$defs/stringList"
        },
        "topRecommendations": {
          "$ref": "#/$defs/stringList"
        },
        "keyFindingRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/findingRef"
          },
          "uniqueItems": true
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/targetRef"
        },
        "name": {
          "$ref": "#/$defs/shortString"
        },
        "repository": {
          "$ref": "#/$defs/shortString"
        },
        "branch": {
          "$ref": "#/$defs/shortString"
        },
        "revision": {
          "$ref": "#/$defs/shortString"
        },
        "includedPaths": {
          "$ref": "#/$defs/stringList"
        },
        "excludedPaths": {
          "$ref": "#/$defs/stringList"
        },
        "languages": {
          "$ref": "#/$defs/stringList"
        },
        "frameworks": {
          "$ref": "#/$defs/stringList"
        },
        "notes": {
          "$ref": "#/$defs/longString"
        }
      }
    },
    "reviewBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/shortString"
        },
        "description": {
          "$ref": "#/$defs/longString"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "auditObjective": {
          "$ref": "#/$defs/longString"
        },
        "sourceAvailability": {
          "$ref": "#/$defs/longString"
        },
        "buildStatus": {
          "$ref": "#/$defs/longString"
        },
        "reviewFocus": {
          "$ref": "#/$defs/stringList"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          }
        },
        "reviewBoundaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reviewBoundary"
          }
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "technical": {
          "$ref": "#/$defs/longString"
        },
        "business": {
          "$ref": "#/$defs/longString"
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "dependentRequired": {
        "cvssScore": [
          "cvssVersion",
          "cvssVector"
        ],
        "cvssVector": [
          "cvssVersion"
        ]
      },
      "properties": {
        "likelihood": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "impact": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "cvssVersion": {
          "type": "string",
          "enum": [
            "3.0",
            "3.1",
            "4.0"
          ]
        },
        "cvssScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "cvssVector": {
          "type": "string",
          "pattern": "^CVSS:(?:3\\.[01]|4\\.0)/"
        },
        "rationale": {
          "$ref": "#/$defs/longString"
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "id"
      ],
      "properties": {
        "scheme": {
          "$ref": "#/$defs/shortString"
        },
        "id": {
          "$ref": "#/$defs/shortString"
        },
        "label": {
          "$ref": "#/$defs/shortString"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "codeFlowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "text"
      ],
      "properties": {
        "stage": {
          "$ref": "#/$defs/shortString"
        },
        "title": {
          "$ref": "#/$defs/shortString"
        },
        "text": {
          "$ref": "#/$defs/longString"
        }
      }
    },
    "sourceAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "source",
            "vulnerable",
            "validation",
            "sink",
            "note"
          ]
        },
        "label": {
          "$ref": "#/$defs/shortString"
        },
        "text": {
          "$ref": "#/$defs/longString"
        }
      }
    },
    "sourceLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "code"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "source",
            "vulnerable",
            "validation",
            "sink"
          ]
        },
        "code": {
          "type": "string",
          "maxLength": 20000
        },
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceAnnotation"
          }
        }
      }
    },
    "sourceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "lines"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/shortString"
        },
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "language": {
          "$ref": "#/$defs/shortString"
        },
        "symbol": {
          "$ref": "#/$defs/shortString"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 400,
          "items": {
            "$ref": "#/$defs/sourceLine"
          }
        }
      }
    },
    "contentBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "format": {
          "$ref": "#/$defs/shortString"
        },
        "language": {
          "$ref": "#/$defs/shortString"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applied"
      ],
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "notes": {
          "$ref": "#/$defs/longString"
        }
      }
    },
    "supportingArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/evidenceRef"
        },
        "type": {
          "$ref": "#/$defs/shortString"
        },
        "title": {
          "$ref": "#/$defs/shortString"
        },
        "description": {
          "$ref": "#/$defs/longString"
        },
        "source": {
          "$ref": "#/$defs/shortString"
        },
        "content": {
          "$ref": "#/$defs/contentBlock"
        },
        "redaction": {
          "$ref": "#/$defs/redaction"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "steps": {
          "$ref": "#/$defs/stringList"
        },
        "demonstration": {
          "$ref": "#/$defs/contentBlock"
        },
        "expectedSecurityBehavior": {
          "$ref": "#/$defs/longString"
        },
        "observedCodeBehavior": {
          "$ref": "#/$defs/longString"
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "url"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/shortString"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "content"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/shortString"
        },
        "format": {
          "const": "unified-diff"
        },
        "language": {
          "$ref": "#/$defs/shortString"
        },
        "path": {
          "$ref": "#/$defs/shortString"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500000,
          "pattern": "^(?:diff --git [^\\r\\n]+\\r?\\n)?[\\s\\S]*--- [^\\r\\n]+\\r?\\n\\+\\+\\+ [^\\r\\n]+\\r?\\n@@ "
        }
      }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "summary": {
          "$ref": "#/$defs/longString"
        },
        "steps": {
          "$ref": "#/$defs/stringList"
        },
        "compensatingControls": {
          "$ref": "#/$defs/stringList"
        },
        "whyItWorks": {
          "$ref": "#/$defs/longString"
        },
        "validationSteps": {
          "$ref": "#/$defs/stringList"
        },
        "residualRisk": {
          "$ref": "#/$defs/longString"
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "patch": {
          "$ref": "#/$defs/patch"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "severity"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/findingRef"
        },
        "title": {
          "$ref": "#/$defs/shortString"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "confirmed",
            "high",
            "medium",
            "low"
          ]
        },
        "summary": {
          "$ref": "#/$defs/longString"
        },
        "description": {
          "$ref": "#/$defs/longString"
        },
        "category": {
          "$ref": "#/$defs/shortString"
        },
        "tags": {
          "$ref": "#/$defs/stringList"
        },
        "affectedTargetRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/targetRef"
          },
          "uniqueItems": true
        },
        "affectedComponents": {
          "$ref": "#/$defs/stringList"
        },
        "reviewBasis": {
          "$ref": "#/$defs/stringList"
        },
        "codeFlow": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/codeFlowStep"
          }
        },
        "impact": {
          "$ref": "#/$defs/impact"
        },
        "risk": {
          "$ref": "#/$defs/risk"
        },
        "mappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mapping"
          }
        },
        "preconditions": {
          "$ref": "#/$defs/stringList"
        },
        "rootCause": {
          "$ref": "#/$defs/longString"
        },
        "securityConsequence": {
          "$ref": "#/$defs/longString"
        },
        "sourceContexts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceContext"
          }
        },
        "supportingArtifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/supportingArtifact"
          }
        },
        "validation": {
          "$ref": "#/$defs/validation"
        },
        "remediation": {
          "$ref": "#/$defs/remediation"
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    }
  }
}
